{
  // Meeting point for Android Viewer when the phones are not on the same network.
  // It forwards sealed messages between one sender and one viewer per room and never sees their contents.
  "name": "android-viewer-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": false }
}
